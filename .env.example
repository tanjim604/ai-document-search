# Copy this file to .env and fill in real values. Never commit .env.

# --- Ingestion and storage (Tahmid) ---
DATABASE_URL=postgresql+psycopg2://ai_docs:ai_docs@localhost:5432/ai_docs
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25
STORAGE_BACKEND=local

# Optional: run the test suite against a SEPARATE PostgreSQL test database.
# Tests delete and recreate tables there, so never point this at ai_docs.
# TEST_DATABASE_URL=postgresql+psycopg2://ai_docs:ai_docs@localhost:5432/ai_docs_test

# --- AI indexing (Zahid) ---
QDRANT_URL=http://localhost:6333
QDRANT_PATH=data/qdrant

# --- Search and integration (Tanjim) ---
# Process each upload in the background (extract, summarise, index).
AUTO_PROCESS_UPLOADS=true
# Similarity labels. Document-level score: >= near is near_duplicate, >= related is related.
NEAR_DUPLICATE_THRESHOLD=0.95
RELATED_THRESHOLD=0.45
# Used only by docker compose for the PostgreSQL password.
# POSTGRES_PASSWORD=change-me
