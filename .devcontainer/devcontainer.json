{
  "name": "AI Document Search",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "AI Document Search", "onAutoForward": "openBrowser" }
  },
  "postStartCommand": "bash scripts/codespace_start.sh"
}
